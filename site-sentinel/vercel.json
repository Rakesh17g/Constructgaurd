{
    "headers": [
        {
            "comment": "ONNX model file — ensure correct MIME type so browsers don't reject it",
            "source": "/models/(.*).onnx",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/octet-stream"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "comment": "WASM files — correct MIME type required for streaming compilation",
            "source": "/onnxruntime/(.*).wasm",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/wasm"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "comment": "HTML pages — COOP+COEP only on the app shell so WASM threads can use SharedArrayBuffer if needed",
            "source": "/(.*).html",
            "headers": [
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                },
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "credentialless"
                }
            ]
        },
        {
            "comment": "Root HTML (SPA) — same COOP/COEP as above",
            "source": "/",
            "headers": [
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                },
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "credentialless"
                }
            ]
        }
    ]
}